{
  "name": "studio123-payload-plugins",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run storybook:typecheck",
    "test": "npm test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry",
    "storybook:typecheck": "tsc -p .storybook/tsconfig.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@payloadcms/translations": "4.0.0-canary.37",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "msw": "3.0.0",
    "msw-storybook-addon": "3.0.3",
    "prettier": "3.9.9",
    "storybook": "10.6.0",
    "vite": "8.3.1"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
