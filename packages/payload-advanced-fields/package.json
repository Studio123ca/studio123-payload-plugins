{
  "name": "@studio123/payload-advanced-fields",
  "version": "1.2.4",
  "private": false,
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./code": {
      "types": "./dist/code-field/index.d.ts",
      "default": "./dist/code-field/index.js"
    },
    "./code/client": {
      "types": "./dist/code-field/client.d.ts",
      "default": "./dist/code-field/client.js"
    },
    "./link": {
      "types": "./dist/link-field/index.d.ts",
      "default": "./dist/link-field/index.js"
    },
    "./link/client": {
      "types": "./dist/link-field/client.d.ts",
      "default": "./dist/link-field/client.js"
    },
    "./color": {
      "types": "./dist/color-field/index.d.ts",
      "default": "./dist/color-field/index.js"
    },
    "./color/client": {
      "types": "./dist/color-field/client.d.ts",
      "default": "./dist/color-field/client.js"
    },
    "./phone": {
      "types": "./dist/phone-field/index.d.ts",
      "default": "./dist/phone-field/index.js"
    },
    "./phone/client": {
      "types": "./dist/phone-field/client.d.ts",
      "default": "./dist/phone-field/client.js"
    },
    "./data-table": {
      "types": "./dist/data-table-field/index.d.ts",
      "default": "./dist/data-table-field/index.js"
    },
    "./data-table/client": {
      "types": "./dist/data-table-field/client.d.ts",
      "default": "./dist/data-table-field/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSES.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Studio123ca/studio123-payload-plugins.git",
    "directory": "packages/payload-advanced-fields"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node esbuild.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run storybook:typecheck",
    "test": "npm run build && node --test tests/*.test.mjs",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry",
    "storybook:typecheck": "tsc -p .storybook/tsconfig.json"
  },
  "peerDependencies": {
    "@payloadcms/ui": "4.0.0-canary.37",
    "payload": "4.0.0-canary.37",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-menubar": "^1.1.24",
    "@tanstack/react-table": "^9.2.4",
    "@uiw/react-codemirror": "^4.25.10",
    "@uiw/react-color": "^2.10.3",
    "libphonenumber-js": "^1.13.8",
    "react-icons": "^5.7.0",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@payloadcms/translations": "4.0.0-canary.37",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/validator": "^13.15.10",
    "esbuild": "^0.28.1",
    "jsdom": "26.1.0",
    "msw": "3.0.0",
    "msw-storybook-addon": "3.0.3",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
