{
  "name": "@studio123/payload-advanced-fields-payload-test-app",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "dev": "cross-env PAYLOAD_CONFIG_PATH=./src/payload.config.ts next dev --webpack --hostname 127.0.0.1",
    "build:plugin": "npm --prefix ../.. run build",
    "generate:importmap": "cross-env PAYLOAD_CONFIG_PATH=./src/payload.config.ts payload generate:importmap",
    "test:e2e": "npm run build:plugin && npm run generate:importmap && playwright test"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "4.0.0-beta.7",
    "@payloadcms/next": "4.0.0-beta.7",
    "@studio123/payload-advanced-fields": "file:../..",
    "cross-env": "^7.0.3",
    "next": "16.4.2",
    "payload": "4.0.0-beta.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
